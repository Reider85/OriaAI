# ── Redis ────────────────────────────────────────────
# Host port 6380 (6379 may be taken by other local projects). Inside the compose
# network the service is reachable as `redis:6379`.
REDIS_URL=redis://127.0.0.1:6380/0

# ── MinIO ────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=llm-client-files
S3_FORENSIC_BUCKET=llm-client-forensic

# ── Vault / KMS ──────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_TRANSIT_KEY=forensic-aes256-gcm
# KMS backend: vault (runtime) | local (TEST ONLY, for unit tests)
KMS_PROVIDER=vault

# ── Observability (ADR-014) ──────────────────────────
# ENVIRONMENT=dev|staging|prod
ENVIRONMENT=dev
# Forensic stream: enabled in staging/prod, off in dev (no Vault dependency).
FORENSIC_STREAM_ENABLED=false
# Operational log sink: stdout | loki | elk
OPERATIONAL_LOG_SINK=stdout
OPERATIONAL_LOG_LOKI_URL=http://loki:3100
OPERATIONAL_LOG_ES_URL=http://elasticsearch:9200

# ── PII detection (ADR-014) ──────────────────────────
# spaCy model used by Presidio. en_core_web_md must be installed:
#   python -m spacy download en_core_web_md
PII_DETECTOR_ENABLED=true
PII_DETECTOR_SPACY_MODEL=en_core_web_md
# Persist pii_score / pii_entities (types+positions only) into messages metadata.
PII_METADATA_ENABLED=true

# ── App ──────────────────────────────────────────────
# File storage: S3-only (extended ADR-008). MinIO is mandatory for dev.
CYCLE_DETECTION_ENABLED=true
CYCLE_DETECTION_THRESHOLD=0.95

# ── S3 access logs → forensic (Block E-4) ────────────
# Comma-separated allow-list of requesters allowed to touch the forensic bucket.
# Anyone else triggers a security alert to SECURITY_ALERT_WEBHOOK_URL.
S3_ACCESS_LOG_ALLOWLIST=llm-client-service
SECURITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME